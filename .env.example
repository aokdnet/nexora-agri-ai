# ==========================================
# NEXORA AGRI AI - Environment Variables
# ==========================================

# 1. Stripe Setup (สำหรับการรับเงินจริง)
# เอามาจาก Stripe Dashboard -> Developers -> API keys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# หากไม่ใส่ STRIPE_SECRET_KEY ระบบจะเข้าสู่ Demo Mode 
# (จำลองการจ่ายเงินผ่านโดยไม่ต้องตัดบัตรจริง)

# 2. Base URL
# URL ของระบบเมื่อ Deploy ขึ้น Vercel
NEXT_PUBLIC_BASE_URL=https://your-nexora-app.vercel.app

# ==========================================
# Phase 2: Database & AI
# ==========================================

# 3. Supabase (Database & Auth)
# เอามาจาก Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG... # เอามาจาก Project Settings -> API (ใช้อัปเดต Profile จาก Webhook)

# 4. Stripe Webhook (สำหรับ Phase 3)
STRIPE_WEBHOOK_SECRET=whsec_... # เอามาจาก Stripe Dashboard -> Webhooks

# 4. Google Gemini (AI Vision)
# เอามาจาก Google AI Studio
GEMINI_API_KEY=AIza...
